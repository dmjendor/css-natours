{
  "name": "css-natours",
  "version": "1.0.0",
  "description": "A small Natours-inspired landing page built with HTML and CSS.",
  "homepage": "https://github.com/dmjendor/css-natours#readme",
  "bugs": {
    "url": "https://github.com/dmjendor/css-natours/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmjendor/css-natours.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "script.js",
  "scripts": {
    "watch:sass": "sass sass/main.scss css/style.css -w",
    "devserver": "live-server",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "sass sass/main.scss css/style.comp.css",
    "concat:css": "concat -o css/style.concat.css css/icon-font.css css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.concat.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "build:css": "npm-run-all compile:sass concat:css prefix:css compress:css"
  },
  "dependencies": {
    "jquery": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concat": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^12.0.0",
    "sass": "^1.103.1"
  }
}
